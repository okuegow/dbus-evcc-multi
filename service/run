#!/bin/sh
# POSIX-safe (works under BusyBox ash on Venus OS - `&>` is NOT POSIX).
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

exec 2>&1

# exec, so that `svc -t` / `svc -d` signal python itself. Without exec they
# kill only this shell and the bridge keeps running as an orphan, holding its
# D-Bus names. The 30 s backoff after a failed start lives in dbus-evcc.py.
exec python3 "$SCRIPT_DIR/../dbus-evcc.py"
